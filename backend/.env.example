# ==============================================================================
# VeerSeva - Smart Orchestrator Platform for Indian Ex-Servicemen
# Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_NAME=VeerSeva
APP_VERSION=1.2.0
FRONTEND_URL=http://localhost:5000

# Security & Secrets
JWT_SECRET=super_secret_jwt_access_key_defense_portal_2026_xyz!
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_defense_portal_2026_abc!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=veerseva_db
DB_CONNECTION_LIMIT=20

# Redis Cache & Session Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Session & Security Policies
IDLE_TIMEOUT_MINUTES=10
SESSION_WARNING_MINUTES=2
TASK_SESSION_TIMEOUT_MINUTES=15
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_TIME_MINUTES=15
OTP_EXPIRY_MINUTES=5
SINGLE_ACTIVE_SESSION=false

# Document Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# India Stack / External API Mock Placeholders
API_SETU_CLIENT_ID=mock_apisetu_client_id_2026
API_SETU_CLIENT_SECRET=mock_apisetu_secret_998877
DIGILOCKER_API_KEY=mock_digilocker_key_112233
